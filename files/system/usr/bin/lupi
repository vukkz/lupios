#!/usr/bin/env bash
# lupi: the LupiOS control tool. Run `lupi help` for the commands.
set -euo pipefail

LEVEL_FILE=/etc/lupios/security-level # persistent
LEVELS=/usr/share/lupios/levels
KARGS_FILE=/usr/share/lupios/kargs
KARGS_DECIDED=/var/lib/lupios/kargs-decided # kargs were set up once; /var is shared by every boot entry
GAME_STATE=/run/lupios/game-mode # /run is cleared at reboot, like Game Mode's firewall changes
# systemd services and NetworkManager's dispatcher run lupi without $HOME, and `set -u` stops at an
# unset variable. Only the terminal toggles use this, and they always run as a user.
USER_FLAGS=${XDG_CONFIG_HOME:-${HOME:-/root}/.config}/lupios
LAB_IMAGE=ghcr.io/vukkz/lupios-lab:latest
TOOLS_BOX=lupi-tools # Arch Linux box that `lupi install` puts command-line tools in
TOOLS_IMAGE=docker.io/library/archlinux:latest
STEAM_SERVICES=(steam-streaming steam-lan-transfer)
UPDATE_TIMERS=(uupd.timer ublue-update.timer rpm-ostreed-automatic.timer flatpak-system-update.timer)

if [[ -t 1 ]]; then
    G=$'\e[32m' Y=$'\e[33m' B=$'\e[1m' D=$'\e[2m' C=$'\e[38;2;51;181;240m' N=$'\e[0m'
else
    G='' Y='' B='' D='' C='' N=''
fi

die() { printf '%s\n' "$*" >&2; exit 1; }
ok() { echo "${G}✔${N} $*"; }
note() { echo "${Y}•${N} $*"; }
as_root() { if ((EUID == 0)); then "$@"; else sudo "$@"; fi; }
ask() { local reply; read -r -p "$1 [y/N] " reply; [[ $reply == [yY]* ]]; }
on_off_usage() { die "Usage: lupi $1 [on|off]"; }

# ---------------------------------------------------------------------------------------
# Networks: lupi net
# ---------------------------------------------------------------------------------------

# UUID of the Wi-Fi or wired connection the internet goes through (VPNs and bridges ignored)
primary_connection() {
    local default_dev uuid type device first=""
    default_dev=$(ip -o route show default 2>/dev/null | awk '{for (i = 1; i < NF; i++) if ($i == "dev") { print $(i + 1); exit }}')
    while IFS=: read -r uuid type device; do
        [[ $type == 802-11-wireless || $type == 802-3-ethernet ]] || continue
        if [[ $device == "$default_dev" ]]; then
            echo "$uuid"
            return 0
        fi
        [[ -n $first ]] || first=$uuid
    done < <(nmcli -t -f UUID,TYPE,DEVICE connection show --active 2>/dev/null)
    [[ -n $first ]] && echo "$first"
}

con_get() { nmcli -g "$2" connection show "$1" 2>/dev/null; }

trust_of_zone() {
    case $1 in
        lupios) echo home ;;
        lupios-public) echo public ;;
        "") echo "not set (treated as home)" ;;
        *) echo "custom (firewall zone: $1)" ;;
    esac
}

# Settings for each trust level. Home undoes everything public changes.
set_trust() { # <uuid> <home|public> [reconnect]
    local uuid=$1 level=$2 reconnect=${3:-yes} type args
    type=$(con_get "$uuid" connection.type)
    if [[ $level == public ]]; then
        # drop all incoming, no local name announcements, don't tell the network our hostname
        args=(connection.zone lupios-public connection.mdns no connection.llmnr no
            ipv4.dhcp-send-hostname no ipv6.dhcp-send-hostname no)
        # a new random MAC address every time we connect, so even this network can't track us
        if [[ $type == 802-11-wireless ]]; then args+=(wifi.cloned-mac-address random); fi
    else
        args=(connection.zone lupios connection.mdns default connection.llmnr default
            ipv4.dhcp-send-hostname yes ipv6.dhcp-send-hostname yes)
        if [[ $type == 802-11-wireless ]]; then args+=(wifi.cloned-mac-address ""); fi
    fi
    as_root nmcli connection modify "$uuid" "${args[@]}"
    if [[ $reconnect == yes ]]; then
        as_root nmcli connection up "$uuid" >/dev/null # reconnect so every setting applies
    fi
}

cmd_net() {
    local uuid name zone
    uuid=$(primary_connection) || true
    [[ -n $uuid ]] || die "Not connected to a Wi-Fi or wired network."
    name=$(con_get "$uuid" connection.id)
    case ${1:-} in
        "")
            zone=$(con_get "$uuid" connection.zone)
            printf '%sNetwork:%s %s\n%sTrust:%s   %s\n\n' "$B" "$N" "$name" "$B" "$N" "$(trust_of_zone "$zone")"
            echo "  lupi net home     trusted network: devices here can find this PC (printers, casting)"
            echo "  lupi net public   untrusted network: invisible to other devices, random MAC address"
            ;;
        home | trusted)
            set_trust "$uuid" home
            ok "'$name' is now trusted (home)."
            ;;
        public | untrusted)
            set_trust "$uuid" public
            ok "'$name' is now untrusted (public): this PC is invisible to other devices on it."
            ;;
        *) die "Usage: lupi net [home|public]" ;;
    esac
}

# Everyone logged in to a desktop, as "<uid> <user>" lines
desktop_users() {
    local session uid user type
    while read -r session uid user _; do
        type=$(loginctl show-session "$session" -p Type --value 2>/dev/null) || continue
        if [[ $type == wayland || $type == x11 ]]; then echo "$uid $user"; fi
    done < <(loginctl list-sessions --no-legend 2>/dev/null)
}

# Tell everyone logged in to a desktop (used by the NetworkManager dispatcher, which runs as root)
notify_desktop_users() { # <title> <body> [icon]
    local uid user
    while read -r uid user; do
        runuser -u "$user" -- env DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
            notify-send -a "LupiOS" -i "${3:-network-wireless}" "$1" "$2" 2>/dev/null || true
    done < <(desktop_users)
}

# Called by /usr/lib/NetworkManager/dispatcher.d/90-lupios-network-trust when a network comes up.
# The first time we meet a network, give it a trust level: Wi-Fi = public, wired = home.
cmd_classify() { # <uuid> <device>
    local uuid=$1 device=$2 zone type level name
    zone=$(con_get "$uuid" connection.zone) || return 0
    [[ -z $zone ]] || return 0 # already has a trust level, or a zone the user picked
    type=$(con_get "$uuid" connection.type)
    case $type in
        802-11-wireless) level=public ;;
        802-3-ethernet) level=home ;;
        *) return 0 ;;
    esac
    name=$(con_get "$uuid" connection.id)
    # Apply the firewall zone right away; the MAC and hostname settings apply from the next connect.
    nmcli connection modify "$uuid" connection.zone "$([[ $level == public ]] && echo lupios-public || echo lupios)"
    nmcli device reapply "$device" >/dev/null 2>&1 || true
    set_trust "$uuid" "$level" no
    if [[ $level == public ]]; then
        notify_desktop_users "New network: $name" "Treated as PUBLIC: this PC is invisible to other devices on it. If this is your home network, run: lupi net home"
    else
        notify_desktop_users "New network: $name" "Treated as HOME (trusted). If it isn't yours, run: lupi net public"
    fi
}

# ---------------------------------------------------------------------------------------
# Game Mode: lupi game (temporary: everything it changes resets at reboot)
# ---------------------------------------------------------------------------------------

power_profile() { # get | set <name>
    if command -v powerprofilesctl >/dev/null; then
        if [[ $1 == get ]]; then powerprofilesctl get; else powerprofilesctl set "$2"; fi
    else
        local obj=(net.hadess.PowerProfiles /net/hadess/PowerProfiles net.hadess.PowerProfiles ActiveProfile)
        if [[ $1 == get ]]; then
            busctl get-property "${obj[@]}" | awk '{gsub(/"/, "", $2); print $2}'
        else
            busctl set-property "${obj[@]}" s "$2"
        fi
    fi
}

game_zone() {
    local uuid zone=""
    uuid=$(primary_connection) || true
    [[ -n $uuid ]] && zone=$(con_get "$uuid" connection.zone)
    [[ -n $zone ]] || zone=$(as_root firewall-cmd --get-default-zone)
    echo "$zone"
}

# The split-lock slowdown makes a few games stutter; SteamOS turns it off. The setting only
# exists on CPUs that detect split locks (mostly Intel), so do nothing elsewhere.
SPLIT_LOCK=/proc/sys/kernel/split_lock_mitigate
splitlock_set() { [[ -e $SPLIT_LOCK ]] && as_root sysctl -q -w "kernel.split_lock_mitigate=$1"; }

game_on() {
    [[ -e $GAME_STATE ]] && { echo "Game Mode is already on. Turn it off with: lupi game off"; return 0; }
    local zone opened="" paused=() previous="" splitlock=""
    zone=$(game_zone)
    if [[ $zone == lupios-public ]]; then
        note "Public network: Steam Remote Play and LAN ports stay closed."
    else
        local args=()
        for s in "${STEAM_SERVICES[@]}"; do args+=("--add-service=$s"); done
        as_root firewall-cmd --zone="$zone" "${args[@]}" >/dev/null
        opened=$zone
        ok "Opened Steam Remote Play and LAN game transfer (until Game Mode is off or reboot)"
    fi
    for t in "${UPDATE_TIMERS[@]}"; do
        if systemctl is-active --quiet "$t"; then
            as_root systemctl stop "$t"
            paused+=("$t")
        fi
    done
    ok "Paused automatic updates"
    if [[ -e $SPLIT_LOCK ]]; then
        splitlock=$(<"$SPLIT_LOCK")
        splitlock_set 0 && ok "Split-lock slowdown off (fixes stutter in a few games)"
    fi
    previous=$(power_profile get 2>/dev/null) || true
    if power_profile set performance >/dev/null 2>&1; then
        ok "Power profile: performance"
    else
        note "This PC has no performance power profile (normal in virtual machines)"
    fi
    as_root mkdir -p "${GAME_STATE%/*}"
    printf 'ZONE=%q\nTIMERS=%q\nPROFILE=%q\nSPLITLOCK=%q\n' "$opened" "${paused[*]}" "$previous" "$splitlock" |
        as_root tee "$GAME_STATE" >/dev/null
    echo "${B}Game Mode is ON.${N} Turn it off with: lupi game off"
}

game_off() {
    [[ -e $GAME_STATE ]] || { echo "Game Mode is already off."; return 0; }
    local ZONE="" TIMERS="" PROFILE="" SPLITLOCK=""
    # shellcheck disable=SC1090
    source "$GAME_STATE"
    if [[ -n $ZONE ]]; then
        local args=()
        for s in "${STEAM_SERVICES[@]}"; do
            # keep ports that are open for good (opened by hand)
            as_root firewall-cmd --permanent --zone="$ZONE" --query-service="$s" >/dev/null 2>&1 || args+=("--remove-service=$s")
        done
        ((${#args[@]} == 0)) || as_root firewall-cmd --zone="$ZONE" "${args[@]}" >/dev/null
        ok "Closed the Steam ports again"
    fi
    for t in $TIMERS; do as_root systemctl start "$t"; done
    ok "Automatic updates resumed"
    if [[ -n $SPLITLOCK ]]; then splitlock_set "$SPLITLOCK" && ok "Split-lock slowdown back on"; fi
    [[ -n $PROFILE ]] && power_profile set "$PROFILE" >/dev/null 2>&1 || true
    as_root rm -f "$GAME_STATE"
    echo "${B}Game Mode is OFF.${N}"
}

cmd_game() {
    case ${1:-} in
        "")
            if [[ -e $GAME_STATE ]]; then echo "Game Mode is ON. Turn it off with: lupi game off"; else echo "Game Mode is OFF. Turn it on with: lupi game on"; fi
            echo "${D}While you play: Steam Remote Play/LAN ports open (home networks only), the split-lock slowdown"
            echo "off (fixes stutter in a few games), automatic updates paused, performance power profile."
            echo "Everything goes back when you turn it off or restart.${N}"
            ;;
        on) game_on ;;
        off) game_off ;;
        *) on_off_usage game ;;
    esac
}

cmd_setup() {
    [[ ${1:-} == gaming ]] || die "Usage: lupi setup gaming"
    echo "Installing Steam, Heroic, Lutris and ProtonUp-Qt (a few GB the first time)..."
    flatpak install --system --noninteractive flathub \
        com.valvesoftware.Steam com.heroicgameslauncher.hgl net.lutris.Lutris net.davidotek.pupgui2
    local branch
    branch=$(flatpak info --system --show-runtime com.valvesoftware.Steam | cut -d/ -f3)
    flatpak install --system --noninteractive flathub \
        "org.freedesktop.Platform.VulkanLayer.MangoHud//${branch}" \
        "org.freedesktop.Platform.VulkanLayer.gamescope//${branch}" ||
        note "Couldn't install MangoHud/gamescope for runtime ${branch}. Steam works without them."
    cat <<EOF

${B}Done.${N} You'll find them in the app menu:
  Steam         your Steam library; Proton runs Windows games
  Heroic        Epic Games, GOG and Amazon Prime games
  Lutris        everything else (Battle.net, EA app, Ubisoft Connect, emulators)
  ProtonUp-Qt   extra Proton versions (e.g. Proton-GE) that fix some games

Tips:
  - Per game in Steam (Properties > Launch Options):  MANGOHUD=1 gamemoderun %command%
  - Before playing:  lupi game on   (Remote Play/LAN ports, stutter fix, updates paused, performance)
  - Check a game works on Linux first: https://www.protondb.com
EOF
}

# ---------------------------------------------------------------------------------------
# Security levels: lupi level (persistent)
# ---------------------------------------------------------------------------------------

# sheep: the calm everyday default. wolf: alert, on the hunt, maximum caution.
current_level() { cat "$LEVEL_FILE" 2>/dev/null || echo sheep; }

level_dns() { # on | off
    if [[ $1 == on ]]; then
        as_root mkdir -p /etc/systemd/resolved.conf.d
        as_root ln -sfn "$LEVELS/wolf/resolved.conf" /etc/systemd/resolved.conf.d/95-lupios-level.conf
        as_root ln -sfn "$LEVELS/wolf/networkmanager.conf" /etc/NetworkManager/conf.d/95-lupios-level.conf
    else
        as_root rm -f /etc/systemd/resolved.conf.d/95-lupios-level.conf /etc/NetworkManager/conf.d/95-lupios-level.conf
    fi
    as_root systemctl restart systemd-resolved
    as_root systemctl reload NetworkManager
}

describe_levels() {
    cat <<EOF
  ${C}sheep${N}    the everyday default: calm, with every protection in SECURITY.md
  ${C}wolf${N}     maximum caution: the sheep level, plus encrypted DNS (Quad9), no replies to pings,
           io_uring and SysRq off, no TCP timestamps, USBGuard and the outgoing guard on
           ${Y}Breaks Wi-Fi login pages (hotels, airports) and apps that need io_uring.${N}

Switching is instant and needs no reboot. Your rollback (the previous OS version) is never touched.
Playing games? That's Game Mode, on any level: lupi game on
EOF
}

cmd_level() { # [level] [--yes]
    local current new=${1:-} yes=${2:-}
    current=$(current_level)
    if [[ -z $new ]]; then
        printf '%sSecurity level:%s %s\n\n' "$B" "$N" "$current"
        describe_levels
        echo
        echo "Change it with: lupi level sheep|wolf"
        return 0
    fi
    [[ $new == sheep || $new == wolf ]] || die "Usage: lupi level [sheep|wolf]"
    [[ $new == "$current" ]] && { echo "Already on the $new level."; return 0; }
    if [[ $new == wolf && $yes != --yes && $yes != -y ]]; then
        echo "${Y}Wolf level (maximum caution):${N}"
        echo "  - Wi-Fi networks with a login page (hotels, airports, trains) won't load it."
        echo "    Switch to the sheep level, log in, then switch back."
        echo "  - A few apps that need io_uring may fail. New USB devices are blocked until allowed."
        echo "  - Apps ask before they connect to the internet (most questions come in the first minutes)."
        ask "Switch to wolf?" || { echo "Nothing changed."; return 0; }
    fi

    as_root mkdir -p /etc/lupios
    as_root ln -sfn "$LEVELS/$new/sysctl.conf" /etc/sysctl.d/95-lupios-level.conf
    as_root systemctl restart systemd-sysctl
    ok "Kernel settings for the $new level applied"

    # Restarting systemd-sysctl re-applied the level's split-lock setting; keep Game Mode's while it's on
    if [[ -e $GAME_STATE ]]; then splitlock_set 0 || true; fi

    # Levels never change kernel boot arguments: that would create a new boot entry, take a
    # minute, need a reboot, and push the previous OS version out of the rollback slot.
    if [[ $new == wolf ]]; then
        level_dns on && ok "Encrypted DNS on (Quad9)"
        usbguard_on by-level && ok "USBGuard on"
        outgoing_on by-level && ok "Outgoing guard on: apps ask before they connect"
    elif [[ $current == wolf ]]; then
        level_dns off && ok "Encrypted DNS off (using the network's DNS again)"
        [[ -e /etc/lupios/usbguard-by-level ]] && usbguard_off && ok "USBGuard off"
        [[ -e /etc/lupios/outgoing-by-level ]] && outgoing_off && ok "Outgoing guard off"
    fi

    echo "$new" | as_root tee "$LEVEL_FILE" >/dev/null
    echo "${B}Security level is now: $new${N}"
}

# ---------------------------------------------------------------------------------------
# USBGuard, kernel boot arguments
# ---------------------------------------------------------------------------------------

usbguard_on() { # [by-level]
    if ! systemctl is-active --quiet usbguard; then
        echo "Allowing every USB device that's plugged in right now, blocking any new ones."
        as_root sh -c 'usbguard generate-policy > /etc/usbguard/rules.conf && chmod 0600 /etc/usbguard/rules.conf'
        as_root systemctl enable --now usbguard
        if [[ ${1:-} == by-level ]]; then as_root touch /etc/lupios/usbguard-by-level; fi
    fi
}
usbguard_off() {
    as_root systemctl disable --now usbguard
    as_root rm -f /etc/lupios/usbguard-by-level
}

cmd_usbguard() {
    case ${1:-} in
        "")
            if systemctl is-active --quiet usbguard; then echo "USBGuard is ON: USB devices plugged in later are blocked until allowed."; else echo "USBGuard is OFF: all USB devices are allowed."; fi
            echo "${D}Allow a blocked device: sudo usbguard list-devices --blocked, then sudo usbguard allow-device <number> -p${N}"
            ;;
        on)
            usbguard_on
            ok "USBGuard is ON. To allow a new device:"
            echo "  sudo usbguard list-devices --blocked"
            echo "  sudo usbguard allow-device <number> -p    (-p remembers it)"
            ;;
        off) usbguard_off && ok "USBGuard is OFF. All USB devices are allowed." ;;
        *) on_off_usage usbguard ;;
    esac
}

kargs_decided() { as_root mkdir -p "${KARGS_DECIDED%/*}" && as_root touch "$KARGS_DECIDED"; }

# Fills kargs_args with the rpm-ostree options that turn the hardening on or off for the next boot
# (no subshell, so a failing rpm-ostree stops us instead of looking like "nothing to change")
kargs_changes() { # <on|off>
    local current arg
    current=" $(rpm-ostree kargs) " # what the next boot will use
    kargs_args=()
    while read -r arg; do
        [[ -z $arg ]] && continue
        if [[ $1 == on && $current != *" $arg "* ]]; then
            kargs_args+=("--append-if-missing=$arg")
        elif [[ $1 == off && $current == *" $arg "* ]]; then
            kargs_args+=("--delete-if-present=$arg")
        fi
    done <"$KARGS_FILE"
}

cmd_kargs() {
    local arg
    case ${1:-} in
        "")
            local now=on next=on cmdline
            cmdline=" $(</proc/cmdline) "
            while read -r arg; do [[ -z $arg || $cmdline == *" $arg "* ]] || now=off; done <"$KARGS_FILE"
            kargs_changes on
            ((${#kargs_args[@]} == 0)) || next=off
            if [[ $now == "$next" ]]; then
                echo "Kernel hardening boot arguments: ${now^^}"
            else
                echo "Kernel hardening boot arguments: ${now^^}, ${next^^} after the next restart"
            fi
            echo "${D}$(tr '\n' ' ' <"$KARGS_FILE")${N}"
            echo "${D}Changing them creates a new boot entry and needs a reboot.${N}"
            return 0
            ;;
        on | off) kargs_changes "$1" ;;
        *) on_off_usage kargs ;;
    esac
    if ((${#kargs_args[@]} == 0)); then
        kargs_decided
        echo "Already $1. If you haven't rebooted since, reboot now."
        return 0
    fi
    as_root rpm-ostree kargs "${kargs_args[@]}"
    kargs_decided # the user chose: the automatic setup below won't change it again
    ok "Kernel hardening boot arguments turned $1. Reboot to apply."
}

# Run as root by lupios-kargs.timer a few minutes after startup, so new installs get the hardening
# without anyone having to remember `lupi kargs on`. It only ever runs until it has worked once,
# and never after the user picked on or off themselves, so `lupi kargs off` stays off.
cmd_kargs_auto() {
    [[ -e $KARGS_DECIDED ]] && return 0
    kargs_changes on
    if ((${#kargs_args[@]})); then
        # fails while an update is running (rpm-ostree does one job at a time); the service retries
        rpm-ostree kargs "${kargs_args[@]}"
        notify_desktop_users "Kernel hardening added" \
            "Extra protection for the kernel turns on the next time you restart. (Undo: lupi kargs off)" security-high
    fi
    kargs_decided
}

# ---------------------------------------------------------------------------------------
# Outgoing guard: lupi outgoing (OpenSnitch, a per-app firewall for outgoing connections)
# ---------------------------------------------------------------------------------------

OUTGOING_UI_UNIT="app-opensnitch_ui@autostart.service" # made from /etc/xdg/autostart/opensnitch_ui.desktop

# Open the pop-up app now instead of at the next login. From the widget we run as root, so
# start it in each desktop user's own session. If a user switched off OpenSnitch's autostart,
# the unit doesn't exist and nothing happens: their choice.
outgoing_ui_start() {
    local user
    if ((EUID != 0)); then
        systemctl --user start "$OUTGOING_UI_UNIT" 2>/dev/null || true
        return 0
    fi
    while read -r _ user; do
        systemctl --user -M "$user@" start "$OUTGOING_UI_UNIT" 2>/dev/null || true
    done < <(desktop_users)
}

outgoing_on() { # [by-level]
    if ! systemctl is-active --quiet opensnitch.service; then
        as_root systemctl enable --now opensnitch.service
        if [[ ${1:-} == by-level ]]; then as_root touch /etc/lupios/outgoing-by-level; fi
    fi
    outgoing_ui_start
}
outgoing_off() {
    as_root systemctl disable --now opensnitch.service
    as_root rm -f /etc/lupios/outgoing-by-level
    # [o] so pkill doesn't match its own command line (or sudo's)
    as_root pkill -f '[o]pensnitch-ui' || true
}

cmd_outgoing() {
    case ${1:-} in
        "")
            if systemctl is-active --quiet opensnitch.service; then
                echo "Outgoing guard is ON: apps ask before they connect to the internet."
            else
                echo "Outgoing guard is OFF: apps connect without asking."
            fi
            echo "${D}Your answers are saved as rules in OpenSnitch (its icon is next to the clock while it's on).${N}"
            ;;
        on)
            outgoing_on
            ok "Outgoing guard is ON. The first time an app connects somewhere, OpenSnitch asks you."
            echo "  Expect a few questions in the first minutes. LupiOS's own services are already allowed."
            echo "  ${D}No OpenSnitch icon next to the clock? Open OpenSnitch from the app menu.${N}"
            ;;
        off) outgoing_off && ok "Outgoing guard is OFF. Your rules are kept for next time." ;;
        *) on_off_usage outgoing ;;
    esac
}

# ---------------------------------------------------------------------------------------
# Terminal: fastfetch and prompt (per user)
# ---------------------------------------------------------------------------------------

user_toggle() { # <name> <flag file> <what it is> [on|off]
    local name=$1 flag="$USER_FLAGS/$2" what=$3
    case ${4:-} in
        "") if [[ -e $flag ]]; then echo "$what is OFF (turn on: lupi $name on)"; else echo "$what is ON (turn off: lupi $name off)"; fi ;;
        on) rm -f "$flag" && ok "$what is ON. Open a new terminal to see it." ;;
        off) mkdir -p "$USER_FLAGS" && touch "$flag" && ok "$what is OFF for new terminals." ;;
        *) on_off_usage "$name" ;;
    esac
}

# ---------------------------------------------------------------------------------------
# Lupi Lab: Kali tools in a container
# ---------------------------------------------------------------------------------------

lab_enter() { # [root]
    local name=lupi-lab root=() podman=(podman) app=burpsuite
    if [[ ${1:-} == root ]]; then
        name=lupi-lab-root root=(--root) podman=(sudo podman) app=wireshark
        echo "Root lab: tools here run as the real root, with raw access to your network hardware"
        echo "and full control of this PC."
        echo "Use it only when a tool needs it, and leave it when you're done."
    fi
    # The lab gets its own home folder, so tool configs, histories and loot stay out of your real one
    local lab_home="$HOME/LupiLab/$name"
    if ! "${podman[@]}" container exists "$name"; then
        echo "Creating $name from $LAB_IMAGE (the first time downloads a few GB)..."
        mkdir -p "$lab_home"
        distrobox create "${root[@]}" --yes --pull --name "$name" --image "$LAB_IMAGE" --home "$lab_home"
        box_first_start "$name" "${root[@]}" || exit 1
        if distrobox enter "${root[@]}" "$name" -- distrobox-export --app "$app" >/dev/null 2>&1; then
            ok "Added $app to your app menu."
        else
            note "Couldn't add $app to the app menu. It still works: run '$app' inside the lab."
        fi
    fi
    # --no-workdir: start in the lab's home, not whatever folder we were run from
    exec distrobox enter "${root[@]}" --no-workdir "$name"
}

# The strict lab: the same Kali image, but run by plain podman instead of distrobox. Distrobox shares
# your home folder, the whole disk (/run/host) and your desktop session with the lab, and turns SELinux
# off for it. The strict lab gets one folder of its own and nothing else, and SELinux confines it
# (container_t), so even a process that breaks out of the container can't read your files.
STRICT_LAB=lupi-lab-strict

lab_strict() { # [command...]
    local shared="$HOME/LupiLab/$STRICT_LAB" tty=()
    if ! podman container exists "$STRICT_LAB"; then
        echo "Creating $STRICT_LAB from $LAB_IMAGE (the first time downloads a few GB)..."
        mkdir -p "$shared"
        # :Z gives the shared folder this lab's own SELinux label. NET_RAW (ping, raw sockets) only
        # counts inside the lab's own network namespace. --init: stops cleanly at shutdown.
        podman create --name "$STRICT_LAB" --hostname "$STRICT_LAB" --pull newer --init \
            --cap-add NET_RAW --volume "$shared:/root/shared:Z" --workdir /root \
            "$LAB_IMAGE" sleep infinity >/dev/null
        ok "Created. Files in ~/LupiLab/$STRICT_LAB on your PC are /root/shared in the strict lab."
    fi
    podman start "$STRICT_LAB" >/dev/null # stopped after every restart; quick, nothing to set up
    [[ -t 0 && -t 1 ]] && tty=(--tty)
    if (($#)); then exec podman exec --interactive "${tty[@]}" "$STRICT_LAB" "$@"; fi
    echo "Strict lab: no access to your files, your desktop or other apps. Shared folder: /root/shared"
    echo "${D}Terminal tools only. For Burp Suite, Wireshark's window or Wi-Fi tools, use: lupi lab${N}"
    # shellcheck disable=SC2016 # $(...) runs inside the lab
    exec podman exec --interactive "${tty[@]}" "$STRICT_LAB" sh -c 'exec "$(command -v zsh || command -v bash)" -l'
}

lab_reset() { # [root|strict]
    case ${1:-} in
        "") distrobox rm --force lupi-lab ;;
        root) distrobox rm --root --force lupi-lab-root ;;
        strict) podman rm --force "$STRICT_LAB" >/dev/null ;;
        *) die "Usage: lupi lab reset [root|strict]" ;;
    esac
    ok "Removed. Files in ~/LupiLab were kept. Run 'lupi lab${1:+ $1}' to create a fresh one."
}

cmd_lab() {
    case ${1:-} in
        "" | root) lab_enter "${1:-}" ;;
        strict) shift && lab_strict "$@" ;;
        reset) lab_reset "${2:-}" ;;
        *) die "Usage: lupi lab [root|strict] | lupi lab strict <command> | lupi lab reset [root|strict]" ;;
    esac
}

# ---------------------------------------------------------------------------------------
# Software: lupi install / remove / search / update
# Apps come from Flathub (sandboxed); command-line tools go into an Arch Linux box, and
# their commands are linked into ~/.local/bin so they work in the terminal like normal commands.
# ---------------------------------------------------------------------------------------

in_box() { distrobox enter "$TOOLS_BOX" -- "$@" | tr -d '\r'; }

# A box's first start sets it up inside (users, devices, packages), which takes minutes in a slow VM.
# Show it and ask not to interrupt: a half-finished setup leaves a box that can't be entered
# ("crun: ptsname: Inappropriate ioctl for device") until it's stopped and started again.
box_first_start() { # <name> [--root]
    echo "Setting up $1 inside. First time only, it can take a few minutes: please don't interrupt it."
    if ! distrobox enter "${@:2}" "$1" -- true; then
        note "The setup didn't finish. Stop the box and try again: ${2:+sudo }podman stop $1"
        return 1
    fi
}

# The apps every install starts with: a browser, and Flatseal to see and change what each app may access
DEFAULT_APPS=(org.mozilla.firefox com.github.tchx84.Flatseal)
DEFAULT_APPS_DONE=/var/lib/lupios/default-apps-done

# Run as root by lupios-default-apps.timer on the first start, and only until it has worked once:
# after that, an app the user removes stays removed. Systems that already have them just get marked done.
cmd_default_apps() {
    [[ -e $DEFAULT_APPS_DONE ]] && return 0
    local missing=() app
    for app in "${DEFAULT_APPS[@]}"; do
        flatpak info --system "$app" >/dev/null 2>&1 || missing+=("$app")
    done
    if ((${#missing[@]})); then
        # fails without internet; the service tries again in 10 minutes
        flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
        flatpak install --system --noninteractive flathub "${missing[@]}"
        notify_desktop_users "Your apps are ready" \
            "Firefox (web browser) and Flatseal (what each app may access) are installed." system-software-install
    fi
    as_root mkdir -p "${DEFAULT_APPS_DONE%/*}"
    as_root touch "$DEFAULT_APPS_DONE"
}

tools_box_ready() {
    podman container exists "$TOOLS_BOX" && return 0
    echo "Creating the Lupi tools box (Arch Linux). First time only..."
    distrobox create --yes --name "$TOOLS_BOX" --image "$TOOLS_IMAGE" >/dev/null
    box_first_start "$TOOLS_BOX"
}

tool_commands() { in_box pacman -Qlq "$1" | grep -E '^/usr/bin/[^/]+$' || true; }

install_app() { # <app ID>
    flatpak install --system --noninteractive flathub "$1"
    ok "Installed $1. You'll find it in the app menu."
}

install_tool() { # <Arch package name>
    local pkg=$1 bin names=()
    tools_box_ready
    if ! in_box sudo pacman -Syu --noconfirm --needed "$pkg"; then
        die "'$pkg' isn't on Flathub or in Arch Linux's packages. Search with: lupi search $pkg"
    fi
    while read -r bin; do
        [[ -n $bin ]] || continue
        in_box distrobox-export --bin "$bin" --export-path "$HOME/.local/bin" >/dev/null
        names+=("${bin##*/}")
    done < <(tool_commands "$pkg")
    if in_box pacman -Qlq "$pkg" | grep -q '^/usr/share/applications/.*\.desktop$'; then
        in_box distrobox-export --app "$pkg" >/dev/null 2>&1 || true
    fi
    ok "Installed $pkg (from Arch Linux, in the Lupi tools box)."
    if ((${#names[@]})); then echo "  Commands you can now run in the terminal: ${names[*]}"; fi
}

cmd_install() { # <name>
    local q=${1:-} hits=() strong=() id name remotes choice i
    [[ -n $q ]] || die "Usage: lupi install <app or tool>   e.g. lupi install discord, lupi install htop"
    if [[ $q == *.*.* ]]; then install_app "$q"; return; fi # a full Flatpak ID like com.discordapp.Discord

    # Search Flathub. Lines look like: <app ID><TAB><name><TAB><remotes>
    while IFS=$'\t' read -r id name remotes; do
        [[ $id == *.* && ,$remotes, == *,flathub,* ]] || continue
        hits+=("$id"$'\t'"$name")
        if [[ ${name,,} == "${q,,}" || ${id,,} == *."${q,,}" ]]; then strong+=("$id"$'\t'"$name"); fi
    done < <(flatpak search --columns=application,name,remotes "$q" 2>/dev/null)

    if ((${#strong[@]} == 1)); then
        IFS=$'\t' read -r id name <<<"${strong[0]}"
        read -r -p "Install ${B}$name${N} ($id) from Flathub? [Y/n] " choice
        [[ $choice == [nN]* ]] && { echo "Nothing installed."; return 0; }
        install_app "$id"
        return
    fi
    if ((${#hits[@]})); then
        echo "Found on Flathub:"
        for i in "${!hits[@]}"; do
            ((i < 8)) || break
            IFS=$'\t' read -r id name <<<"${hits[$i]}"
            printf '  %s%d)%s %s %s(%s)%s\n' "$C" $((i + 1)) "$N" "$name" "$D" "$id" "$N"
        done
        printf '  %st)%s none of these: install "%s" as a command-line tool\n' "$C" "$N" "$q"
        read -r -p "Which one? [1-$((i < 8 ? i + 1 : 8)), t, or Enter to cancel] " choice
        case $choice in
            "") echo "Nothing installed." ;;
            t | T) install_tool "$q" ;;
            *[!0-9]*) die "Not a choice: $choice" ;;
            *)
                ((choice >= 1 && choice <= ${#hits[@]})) || die "Not a choice: $choice"
                IFS=$'\t' read -r id name <<<"${hits[$((choice - 1))]}"
                install_app "$id"
                ;;
        esac
        return
    fi
    install_tool "$q"
}

cmd_remove() { # <name>
    local q=${1:-} id="" bin app name
    [[ -n $q ]] || die "Usage: lupi remove <app or tool>"
    while IFS=$'\t' read -r app name; do
        if [[ ${app,,} == "${q,,}" || ${name,,} == "${q,,}" ]]; then id=$app; break; fi
    done < <(flatpak list --app --columns=application,name 2>/dev/null)
    if [[ -n $id ]]; then
        # A running app keeps going (tray icon and all) after uninstalling, so close it first
        if flatpak ps --columns=application 2>/dev/null | grep -qxF "$id"; then
            note "$id is running. Closing it first."
            flatpak kill "$id" 2>/dev/null || true
            sleep 1
        fi
        flatpak uninstall --noninteractive "$id"
        ok "Removed $id. Its settings are kept in ~/.var/app/$id (delete that folder to remove them too)."
        return
    fi
    if podman container exists "$TOOLS_BOX" && in_box pacman -Qq "$q" >/dev/null 2>&1; then
        while read -r bin; do
            [[ -n $bin ]] && in_box distrobox-export --bin "$bin" --export-path "$HOME/.local/bin" --delete >/dev/null 2>&1
        done < <(tool_commands "$q")
        in_box sudo pacman -Rns --noconfirm "$q" >/dev/null
        ok "Removed $q from the Lupi tools box."
        return
    fi
    die "'$q' isn't installed as an app or in the Lupi tools box. See your apps with: flatpak list --app"
}

cmd_search() { # <name>
    local q=${1:-}
    [[ -n $q ]] || die "Usage: lupi search <name>"
    echo "${B}Apps on Flathub${N} (install with: lupi install <name or ID>)"
    flatpak search --columns=name,application "$q" 2>/dev/null | head -10 | sed 's/^/  /' || true
    echo
    if podman container exists "$TOOLS_BOX"; then
        echo "${B}Command-line tools from Arch Linux${N}"
        in_box pacman -Ss "$q" | head -20 | sed 's/^/  /' || true
    else
        echo "${D}Command-line tools come from Arch Linux: lupi install <name> sets that up on first use.${N}"
    fi
}

cmd_update() {
    local t0
    t0=$(date +%s)
    echo "Updating the system, your apps and your boxes. This can take a few minutes..."
    if [[ -e /usr/lib/systemd/system/uupd.service ]]; then
        as_root systemctl start uupd.service # Universal Blue's updater, the same one `ujust update` uses
        as_root journalctl -u uupd.service --since "@$t0" -o cat --no-pager | tail -15
    else
        as_root rpm-ostree upgrade
        flatpak update --noninteractive
        distrobox upgrade --all || true
    fi
    if rpm-ostree status --json | jq -e '.deployments[] | select(.staged == true)' >/dev/null 2>&1; then
        ok "Update downloaded. ${B}Reboot to finish:${N} systemctl reboot"
    else
        ok "Everything is up to date."
    fi
}

# Update channels: stable = the `latest` tag (built from the main branch), testing = the
# `br-testing-<Fedora version>` tag (built from the testing branch, where changes land first).
cmd_channel() {
    local ref image tag version current target
    ref=$(rpm-ostree status --json | jq -r '.deployments[] | select(.booted) | ."container-image-reference" // empty')
    ref=$(sed -E 's#^[^:]+:(docker://)?##' <<<"$ref") # drop "ostree-image-signed:docker://" etc.
    image=${ref%:*} tag=${ref##*:}
    version=$(. /etc/os-release && echo "$VERSION_ID")
    current=stable
    [[ $tag == br-testing-* ]] && current=testing
    case ${1:-} in
        "")
            printf '%sUpdate channel:%s %s  %s(%s)%s\n\n' "$B" "$N" "$current" "$D" "$ref" "$N"
            echo "  stable    what friends and your main PC should use"
            echo "  testing   new changes arrive here first; use it in a VM to try them"
            echo
            echo "Switch with: lupi channel stable|testing"
            return 0
            ;;
        stable) target="$image:latest" ;;
        testing) target="$image:br-testing-$version" ;;
        *) die "Usage: lupi channel [stable|testing]" ;;
    esac
    [[ $1 == "$current" ]] && { echo "Already on the $1 channel."; return 0; }
    as_root rpm-ostree rebase "ostree-image-signed:docker://$target"
    ok "Switched to the $1 channel ($target). Reboot to start it: systemctl reboot"
}

# Machine-readable state for the LupiOS panel widget and LupiOS Welcome (key=value lines)
cmd_state() {
    local uuid zone="" name="" net=offline
    uuid=$(primary_connection) || true
    if [[ -n $uuid ]]; then
        zone=$(con_get "$uuid" connection.zone)
        name=$(con_get "$uuid" connection.id)
        case $zone in lupios) net=home ;; lupios-public) net=public ;; "") net="unset" ;; *) net=custom ;; esac
    fi
    echo "level=$(current_level)"
    echo "net=$net"
    echo "net_name=$name"
    echo "game=$([[ -e $GAME_STATE ]] && echo on || echo off)"
    echo "outgoing=$(systemctl is-active --quiet opensnitch.service && echo on || echo off)"
    echo "score=$(/usr/bin/lupi-security-check 2>/dev/null | sed -n 's/.*Score: //p')"
}

# ---------------------------------------------------------------------------------------

usage() {
    cat <<EOF
${B}lupi${N}: the LupiOS control tool

${B}Software${N}
  ${C}lupi install${N} <name>              install an app (Flathub) or a command-line tool (Arch)
  ${C}lupi remove${N} <name>               remove it again
  ${C}lupi search${N} <name>               look for apps and tools
  ${C}lupi update${N}                      update the system, apps and boxes
  ${C}lupi channel${N} [stable|testing]    which updates you get (testing = new changes first)

${B}Security${N}
  ${C}lupi check${N}                       how locked-down this system is
  ${C}lupi level${N} [sheep|wolf]          security level: how careful (stays until you change it)
  ${C}lupi net${N} [home|public]           trust level of the network you're on
  ${C}lupi kargs${N} [on|off]              kernel hardening boot arguments (on by itself after install)
  ${C}lupi usbguard${N} [on|off]           block USB devices plugged in later
  ${C}lupi outgoing${N} [on|off]           apps ask before they connect to the internet (OpenSnitch)

${B}Gaming${N}
  ${C}lupi setup gaming${N}                install Steam, Heroic, Lutris, ProtonUp-Qt, MangoHud
  ${C}lupi game${N} [on|off]               Game Mode while you play (off again at restart)

${B}Hacking lab${N}
  ${C}lupi lab${N} [root]                  enter the Lupi Lab (Kali tools in a container)
  ${C}lupi lab strict${N} [command]        the lab without access to your files (terminal tools only)
  ${C}lupi lab reset${N} [root|strict]     start the lab fresh from the newest image

${B}Terminal${N}
  ${C}lupi fastfetch${N} [on|off]          the wolf at the top of new terminals
  ${C}lupi prompt${N} [on|off]             the icy terminal prompt

Leave out the part in [brackets] to see the current state.
Universal Blue's own extra commands: ${C}ujust${N}
EOF
}

# Through pkexec, lupi runs as root on the strength of a password typed into the widget or LupiOS
# Welcome, and polkit may let any program in the session reuse that for a few minutes. So pkexec
# only gets the switches those two offer. Everything else (the lab, installs, updates) could hand
# out a root shell: run it in a terminal, where sudo asks for the password itself.
if [[ -n ${PKEXEC_UID:-} ]]; then
    case "$#:${1:-} ${2:-} ${3:-}" in
        "2:level sheep " | "2:level wolf " | "3:level sheep --yes" | "3:level wolf --yes" | \
            "2:net home " | "2:net public " | "2:game on " | "2:game off ") ;;
        *) die "lupi $*: not available through pkexec (the panel widget and Welcome). Run it in a terminal." ;;
    esac
fi

case ${1:-help} in
    check | status) exec /usr/bin/lupi-security-check ;;
    level) cmd_level "${2:-}" "${3:-}" ;;
    net | network) cmd_net "${2:-}" ;;
    kargs) cmd_kargs "${2:-}" ;;
    usbguard) cmd_usbguard "${2:-}" ;;
    outgoing) cmd_outgoing "${2:-}" ;;
    setup) cmd_setup "${2:-}" ;;
    game) cmd_game "${2:-}" ;;
    lab) cmd_lab "${@:2}" ;;
    fastfetch) user_toggle fastfetch fastfetch-off "fastfetch at the top of new terminals" "${2:-}" ;;
    prompt) user_toggle prompt prompt-off "The LupiOS prompt" "${2:-}" ;;
    install) cmd_install "${2:-}" ;;
    remove | uninstall) cmd_remove "${2:-}" ;;
    search) cmd_search "${2:-}" ;;
    update | upgrade) cmd_update ;;
    channel) cmd_channel "${2:-}" ;;
    state) cmd_state ;;
    _classify) cmd_classify "$2" "$3" ;;
    _kargs-auto) cmd_kargs_auto ;;
    _default-apps) cmd_default_apps ;;
    help | -h | --help) usage ;;
    *) usage; exit 1 ;;
esac
