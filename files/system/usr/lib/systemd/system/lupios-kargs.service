[Unit]
Description=LupiOS: add the kernel hardening boot arguments
Documentation=https://github.com/vukkz/lupios/blob/main/SECURITY.md
# Only on an installed LupiOS, and only until it has worked once or the user ran
# `lupi kargs on/off` themselves (lupi creates this file in both cases)
ConditionPathExists=/run/ostree-booted
ConditionPathExists=!/var/lib/lupios/kargs-decided

[Service]
Type=oneshot
ExecStart=/usr/bin/lupi _kargs-auto
# rpm-ostree does one job at a time; if an update is running, try again later
Restart=on-failure
RestartSec=10min
