## Lorax template, run while build-iso.yml builds the installer (build-container-installer's
## additional_templates). The installer runs on Fedora's own packages, and fedora-logos brands
## it as Fedora: put the Wolf OS artwork and stylesheet in place of Fedora's.
## ${root} is the installer's file system. The repo is mounted at /github/workspace, and
## build-iso.yml has already rendered the PNGs into iso/anaconda/build.
<%page args="root"/>
<% src = "/github/workspace/iso/anaconda" %>
runcmd cp ${src}/build/sidebar-logo.png ${src}/build/sidebar-bg.png ${src}/build/topbar-bg.png ${root}/usr/share/anaconda/pixmaps/
## Every stylesheet, including the per-edition ones (atomic, silverblue, ...), so it doesn't matter which one the installer picks
runcmd find ${root}/usr/share/anaconda/pixmaps -name *.css -exec cp ${src}/wolf-os.css {} \;
