---
// The frame of the field-guide pages (the home page and the download page): fonts, the masthead,
// the colophon, and the little script behind the motion. The docs pages stay Starlight.
// Arimo has the Helvetica letter shapes the LupiOS logo is set in (bold "Lupi", regular "OS").
import "@fontsource/arimo/latin-400.css";
import "@fontsource/arimo/latin-700.css";
import "@fontsource/arimo/latin-400-italic.css";
import "@fontsource/jetbrains-mono/latin-400.css";
import "../styles/guide.css";
import lockup from "../assets/lupios-lockup-dark.svg";
import ridge from "../assets/guide-ridge.svg";

interface Props {
  title: string;
  description: string;
  path: string; // "/" or "/download/"
  shareTitle?: string;
}
const { title, description, path, shareTitle = title } = Astro.props;
const repo = "https://github.com/vukkz/lupios";
const url = new URL(path, "https://lupios.org").href;
const nav = [
  { href: "/install/", label: "Install" },
  { href: "/lupi/", label: "The lupi command" },
  { href: "/security/", label: "Security" },
  { href: "/faq/", label: "FAQ" },
  { href: repo, label: "GitHub" },
];
---

<!doctype html>
<html lang="en" class="guide-root">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0B1220" />
    <meta name="color-scheme" content="dark" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="LupiOS" />
    <meta property="og:image" content="https://lupios.org/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The LupiOS logo above night mountains" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://lupios.org/og.png" />
    <!-- Before the first paint: lines may only start undrawn when they will get drawn (motion
         wanted, and the browser can tell when a section comes into view). Without this, everything
         is simply there. -->
    <script is:inline>
      if (matchMedia("(prefers-reduced-motion: no-preference)").matches && "IntersectionObserver" in window) {
        document.documentElement.classList.add("motion");
      }
    </script>
  </head>
  <body class="guide">
    <a class="skip" href="#main">Skip to the content</a>
    <header class="masthead">
      <a class="home" href="/" aria-label="LupiOS home">
        <img src={lockup.src} width="128" height="40" alt="LupiOS" />
      </a>
      <nav class="main-nav" aria-label="Main">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>
      <!-- narrow screens: the same links behind a Menu toggle (no script needed) -->
      <details class="menu">
        <summary><span class="open-label">Menu</span><span class="close-label">Close</span></summary>
        <nav aria-label="Main">
          {nav.map((n) => <a href={n.href}>{n.label}</a>)}
        </nav>
      </details>
      <a class="button" href="/download/" aria-current={path === "/download/" ? "page" : undefined}>Download</a>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="colophon">
      <img class="ridge" src={ridge.src} alt="" width="2400" height="260" data-draw />
      <p class="basis">
        LupiOS is built on <a href="https://fedoraproject.org/atomic-desktops/">Fedora Atomic</a> and KDE Plasma,
        through <a href="https://universal-blue.org">Universal Blue</a> and <a href="https://blue-build.org">BlueBuild</a>.
        Fedora's security team patches the base.
      </p>
      <nav aria-label="Everything else">
        <a href="/download/">Download</a>
        <a href="/install/">Install</a>
        <a href="/dual-boot/">Keeping Windows</a>
        <a href="/lupi/">The lupi command</a>
        <a href="/security/">Security</a>
        <a href="/changes/">What's new</a>
        <a href="/faq/">FAQ</a>
        <a href={`${repo}/discussions`}>Questions</a>
        <a href={`${repo}/security/advisories/new`}>Report a security problem</a>
      </nav>
    </footer>

    <script is:inline>
      // Ink being drawn: each [data-draw] section rules its lines in once it scrolls into view
      if (document.documentElement.classList.contains("motion")) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("drawn");
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: "0px 0px -12% 0px" },
        );
        document.querySelectorAll("[data-draw]").forEach((el) => io.observe(el));
      }
      // Copy buttons on commands: only shown where the browser lets a page write to the clipboard
      if (navigator.clipboard) {
        for (const button of document.querySelectorAll(".cmd .copy")) {
          button.hidden = false;
          button.addEventListener("click", async () => {
            try {
              await navigator.clipboard.writeText(button.dataset.code);
              button.textContent = "Copied";
            } catch {
              button.textContent = "Select and copy it";
            }
            setTimeout(() => (button.textContent = "Copy"), 2000);
          });
        }
      }
    </script>
  </body>
</html>
